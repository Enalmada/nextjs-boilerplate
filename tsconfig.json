{
	"compilerOptions": {
		"target": "es5",
		"lib": ["dom", "dom.iterable", "esnext", "webworker"],
		"types": ["vitest/globals", "@serwist/next/typings"],

		"allowJs": true,
		"checkJs": true,
		"skipLibCheck": true,
		"strict": true,
		"forceConsistentCasingInFileNames": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
		"noUncheckedIndexedAccess": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"next/*": ["./node_modules/next/*"] // Necessary to solve next request being out of sync with 3rd party peer dependencies
		},
		"plugins": [
			{
				"name": "next"
			},
			{
				"name": "gql.tada/ts-plugin",
				"schema": "./src/client/gql/generated/schema.graphql",
				"tadaOutputLocation": "./src/client/gql/generated/graphql-env.d.ts",
				"tadaTurboLocation": "./src/client/gql/generated/graphql-cache.d.ts"
			}
		],
		"allowSyntheticDefaultImports": true,
		"sourceMap": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.mjs",
		"next-env.d.ts",
		"*.cjs",
		"*.mjs",
		".next/types/**/*.ts",
		"drizzle.config.ts",
		"vitest.config.ts",
		"codegen.ts",
		"playwright.config.ts"
	],
	"exclude": ["node_modules", "packages/**", "public/sw.js"]
}
